{
  "name": "agent-activity-logger",
  "version": "1.0.0",
  "description": "Agent Activity Logger - AI Security Monitoring Dashboard (Cloudflare Workers + Workers AI + D1)",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --persist-to ./.wrangler/state",
    "db:migrate:local": "wrangler d1 migrations apply agent-activity-db --local --persist-to ./.wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply agent-activity-db --remote",
    "db:init:local": "npm run db:migrate:local",
    "typecheck": "tsc -p .",
    "test": "node --test --test-reporter=spec --disable-warning=ExperimentalWarning worker/test/agent.test.ts worker/test/security.test.ts",
    "build:frontend": "npm --prefix frontend run build",
    "check": "npm run typecheck && npm test && npm run build:frontend && wrangler deploy --dry-run",
    "deploy": "npm run typecheck && npm test && npm run build:frontend && wrangler deploy"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261107.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.158.0"
  }
}
